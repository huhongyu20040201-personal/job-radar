__pycache__/
*.pyc

# Claude Code local settings, unrelated to the project
.claude/

# Log from local runs
run.log

# In case a token was ever stored locally, keep it out of the repo
secrets.bat
.env

# Run state. The GitHub workflow keeps these on the `state` branch, not on main,
